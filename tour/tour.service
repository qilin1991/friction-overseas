[Unit]
Description=Hangzhou Activity Hub (/tour)
After=network.target

[Service]
User=archive
Group=archive
WorkingDirectory=/opt/tour
Environment=PYTHONPATH=/opt/tour
ExecStart=/opt/friction/venv/bin/waitress-serve --listen=127.0.0.1:8090 --threads=4 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
